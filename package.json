{
  "name": "mutation-invariance-kit",
  "version": "0.1.0",
  "description": "Prove a decision, score, or ranking function's output does not depend on a variable it claims not to depend on (a protected attribute, geography, price, or any axis you name) — a generic runtime mutation-and-diff check, framework-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "invariance",
    "fairness-testing",
    "algorithmic-accountability",
    "property-testing",
    "testing",
    "honesty",
    "vitest"
  ],
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
